{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Certificate Extractor",
  "version": "0.1.0",
  "identifier": "com.domaingts.certextractor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "Certificate Extractor",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Inspect and export TLS server certificates",
    "longDescription": "Connects to a TLS server, displays its server-presented certificate chain, and exports selected certificates as PEM or a C-style string expression.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
          "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
